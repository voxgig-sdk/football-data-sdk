            "{id}"
            "teams"
          ]
          select: {
            "$action": "team"
            exist: [
              "id"
              "season"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.competition`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "area"
                orig: "area"
                reqd: false
