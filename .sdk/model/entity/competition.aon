            "competitions"
            "{id}"
            "scorers"
          ]
          select: {
            "$action": "scorer"
            exist: [
              "id"
              "limit"
              "season"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.competition`"
          }
        }
        {
