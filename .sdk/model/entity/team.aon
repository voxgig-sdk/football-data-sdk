      type: "`$STRING`"
    }
    {
      name: "area"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "awayTeam"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "clubColors"
      req: false
      short: "Team colors"
      type: "`$STRING`"
    }
    {
      name: "coach"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "competition"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "crest"
      req: false
      short: "URL to the team's crest image"
      type: "`$STRING`"
    }
    {
      name: "founded"
      req: false
      short: "Year the team was founded"
