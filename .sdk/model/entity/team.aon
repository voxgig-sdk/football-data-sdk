    }
    {
      name: "status"
      req: false
      short: "Match status"
      type: "`$STRING`"
    }
    {
      name: "tla"
      req: false
      short: "Three-letter abbreviation"
      type: "`$STRING`"
    }
    {
      name: "utcDate"
      req: false
      short: "Match date and time in UTC"
      type: "`$STRING`"
    }
    {
      name: "venue"
      req: false
