      req: false
      short: "Competitions the team is currently participating in"
      type: "`$ARRAY`"
    }
    {
      name: "score"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "season"
      req: false
      type: "`$OBJECT`"
    }
