ction\":{\"description\":\"Section (e.g., Offence, Defence, Midfield, Goalkeeper)\",\"nullable\":true,\"type\":\"string\"},\"shirtNumber\":{\"description\":\"Shirt number\",\"nullable\":true,\"type\":\"integer\"}},\"type\":\"object\"},\"resultSet\":{\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successful response with matches\"},\"400\":{\"description\":\"Bad request\"},\"403\":{\"description\":\"Forbidden - Invalid API key\"},\"404\":{\"description\":\"Person not found\"},\"429\":{\"description\":\"Too many requests\"}},\"security\":[{\"ApiKeyAuth\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"description\":\"API key for authentication. Obtain from https://www.football-data.org\",\"in\":\"header\",\"name\":\"X-Auth-Token\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
