      type: "`$OBJECT`"
    }
    {
      name: "awayTeam"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "bookings"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "competition"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "goals"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "group"
      req: false
