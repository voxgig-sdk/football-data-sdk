      type: "`$STRING`"
    }
    {
      name: "homeTeam"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the match"
      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "lastUpdated"
      req: false
      short: "Last update timestamp"
      type: "`$STRING`"
    }
    {
      name: "matchday"
      req: false
      short: "Matchday number"
      type: "`$INTEGER`"
    }
    {
      name: "odds"
      req: false
      short: "Match odds"
      type: "`$OBJECT`"
    }
    {
      name: "referees"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "score"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "season"
      req: false
      type: "`$OBJECT`"
    }
    {
